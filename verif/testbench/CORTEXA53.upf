#-------------------------------------------------------------------------------
# Function: This is a top-level hierarchical UPF for a quad CORTEXA53
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# elements
#-------------------------------------------------------------------------------
set CPU0_hier g_ca53_cpu\[0\]/u_ca53_cpu

set FPU0_hier g_ca53_cpu\[0\]/u_ca53_cpu/u_ca53_noram/u_ca53dpu/FPU1/u_dpu_fp

set L2_hier   [list u_ca53_l2/g_l2_rams/u_ca53_l2_datarams \
                    u_ca53_l2/g_l2_rams/u_ca53_l2_tagrams \
		    u_ca53_l2/u_ca53scu_l1d_tagrams ]

#-------------------------------------------------------------------------------
# clamp high signals list
#-------------------------------------------------------------------------------
# Note: AWBURSTM[0] can be clamped 1 but current version of tools are not supporting it. 
set CA53_CLAMP1 [list nVCPUMNTIRQ \
                      nCNTPNSIRQ \
                      nCNTPSIRQ\
                      nCNTVIRQ \
                      nCNTHPIRQ \
                      STANDBYWFI \
                      STANDBYWFIL2 \
                      nINTERRIRQ \
                      nEXTERRIRQ \
                      nCOMMIRQ \
                      COMMTX \
                      nPMUIRQ \
                      AFREADYM0 \
                      PREADYDBG \
		      CTICHINACK \
		      BREADYM \
                      PSLVERRDBG ]

set CPU0_CLAMP1 [list g_ca53_cpu\[0\]/u_ca53_cpu/dpu_commtx_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/stb_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/biu_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dcu_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/ifu_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/tlb_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/etm_wfx_ready_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/etm_afreadym_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/etm_oslock_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dpu_ncommirq_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dpu_npmuirq_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dpu_pslverrdbg_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dpu_preadydbg_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/etm_preadydbg_o \
			g_ca53_cpu\[0\]/u_ca53_cpu/dpu_exception_level_o ]	

#-------------------------------------------------------------------------------
# Supply Sets
#-------------------------------------------------------------------------------

create_supply_set SOC_ss
create_supply_set PDCORTEXA53_ss
create_supply_set PDL2_ss
create_supply_set PDCPU0_ss
create_supply_set PDCPUADVSIMD0_ss

#-------------------------------------------------------------------------------
# Power Domains
#-------------------------------------------------------------------------------

#Making use of string searches here to handle instance name changes when generate verilog commands are used
#when instantiated multiple CPU

set cpu0_name [string trimright [lindex [find_objects . -object_type inst -pattern g_ca53_cpu*0*u_ca53_cpu] 0]]

create_power_domain PDCORTEXA53  -include_scope \
        -supply {primary} -supply {default_isolation}
create_power_domain PDL2  -elements "$L2_hier" \
        -supply {primary} -supply {default_retention}
create_power_domain PDCPU0 -elements $cpu0_name \
        -supply {primary} -supply {default_retention}  
create_power_domain PDCPUADVSIMD0  -elements "$FPU0_hier" \
        -supply {primary} -supply {default_retention}

#-------------------------------------------------------------------------------
# Supply Nets and Ports
#-------------------------------------------------------------------------------

create_supply_port VDD
create_supply_port VSS

create_supply_net VDD
create_supply_net VSS

connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS

create_supply_net VDDCORTEXA53   -resolve parallel 
create_supply_net VDDCPU0        -resolve parallel
create_supply_net VDDCPUADVSIMD0 -resolve parallel
create_supply_net VDDL2          -resolve parallel

#-------------------------------------------------------------------------------
# Successive Refinement of Supply Sets
#-------------------------------------------------------------------------------

create_supply_set SOC_ss         -function {power VDD}          -function {ground VSS}   -update
create_supply_set PDCORTEXA53_ss -function {power VDDCORTEXA53} -function {ground VSS}   -update
create_supply_set PDCPU0_ss      -function {power VDDCPU0}      -function {ground VSS}   -update
create_supply_set PDL2_ss        -function {power VDDL2}        -function {ground VSS}   -update
create_supply_set PDCPUADVSIMD0_ss -function {power VDDCPUADVSIMD0} -function {ground VSS} -update

#-------------------------------------------------------------------------------
# Supply Sets association with Power Domains
#-------------------------------------------------------------------------------

associate_supply_set PDCORTEXA53_ss   -handle PDCORTEXA53.primary
associate_supply_set SOC_ss           -handle PDCORTEXA53.default_isolation
associate_supply_set PDL2_ss          -handle PDL2.primary
associate_supply_set SOC_ss           -handle PDL2.default_retention
associate_supply_set PDCPU0_ss        -handle PDCPU0.primary
associate_supply_set PDCORTEXA53_ss   -handle PDCPU0.default_isolation
associate_supply_set SOC_ss           -handle PDCPU0.default_retention
associate_supply_set PDCPUADVSIMD0_ss -handle PDCPUADVSIMD0.primary
associate_supply_set PDCORTEXA53_ss   -handle PDCPUADVSIMD0.default_isolation
associate_supply_set SOC_ss           -handle PDCPUADVSIMD0.default_retention

#-------------------------------------------------------------------------------
# Power Switch Control Signals
#-------------------------------------------------------------------------------

create_logic_port -direction in nPWRUPCORTEXA53
create_logic_port -direction in nPWRUPL2
create_logic_port -direction in nPWRUPCPU0ADVSIMD
create_logic_port -direction in nPWRUPCPU0

create_logic_net nPWRUPCORTEXA53
create_logic_net nPWRUPL2
create_logic_net nPWRUPCPU0ADVSIMD
create_logic_net nPWRUPCPU0

connect_logic_net nPWRUPCORTEXA53       -ports nPWRUPCORTEXA53
connect_logic_net nPWRUPL2	        -ports nPWRUPL2
connect_logic_net nPWRUPCPU0ADVSIMD     -ports nPWRUPCPU0ADVSIMD
connect_logic_net nPWRUPCPU0	        -ports nPWRUPCPU0


#-------------------------------------------------------------------------------
# Power Switches
#-------------------------------------------------------------------------------

create_power_switch ps_CORTEXA53 -domain PDCORTEXA53 \
    -input_supply_port { VDDG VDD } \
    -output_supply_port { VDD VDDCORTEXA53 } \
    -control_port { SLEEP nPWRUPCORTEXA53 } \
    -on_state { on_state VDDG {!SLEEP} } \
    -off_state { off_state {SLEEP} }

create_power_switch ps_CPU0 -domain PDCPU0 \
    -input_supply_port { VDDG VDD } \
    -output_supply_port { VDD VDDCPU0 } \
    -control_port { SLEEP nPWRUPCPU0 } \
    -on_state { on_state VDDG {!SLEEP} } \
    -off_state { off_state {SLEEP} }

create_power_switch ps_L2 -domain PDL2 \
    -input_supply_port { VDDG VDD } \
    -output_supply_port { VDD VDDL2 } \
    -control_port { SLEEP nPWRUPL2 } \
    -on_state { on_state VDDG {!SLEEP} } \
    -off_state { off_state {SLEEP} }

create_power_switch ps_CPU0ADVSIMD -domain PDCPUADVSIMD0 \
    -input_supply_port { VDDG VDD } \
    -output_supply_port { VDD VDDCPUADVSIMD0 } \
    -control_port { SLEEP nPWRUPCPU0ADVSIMD } \
    -on_state { on_state VDDG {!SLEEP} } \
    -off_state { off_state {SLEEP} }


# map_power_switch ps_CORTEXA53 -domain PDCORTEXA53 -lib_cells HEADTIE22_A9TS_C31
# map_power_switch ps_CPU0 -domain PDCPU0 -lib_cells HEADTIE22_A9TS_C31


#-------------------------------------------------------------------------------
# Isolation Control Signals
#-------------------------------------------------------------------------------
create_logic_port -direction in nISOLATECORTEXA53
create_logic_port -direction in nISOLATEL2
create_logic_port -direction in nISOLATECPU0
create_logic_port -direction in nISOLATECPU0ADVSIMD
     
create_logic_net nISOLATECORTEXA53
create_logic_net nISOLATEL2
create_logic_net nISOLATECPU0
create_logic_net nISOLATECPU0ADVSIMD

connect_logic_net nISOLATECORTEXA53   -ports nISOLATECORTEXA53
connect_logic_net nISOLATEL2	      -ports nISOLATEL2
connect_logic_net nISOLATECPU0	      -ports nISOLATECPU0
connect_logic_net nISOLATECPU0ADVSIMD -ports nISOLATECPU0ADVSIMD


#-------------------------------------------------------------------------------
# Port Attributes / Related Supply 
#-------------------------------------------------------------------------------

set all_outputs [find_objects . -object_type port -direction out  -pattern *]
set all_inputs  [find_objects . -object_type port -direction in   -pattern *]

set_port_attributes -ports $all_inputs    -driver_supply   SOC_ss
set_port_attributes -ports $all_outputs   -receiver_supply SOC_ss

#-------------------------------------------------------------------------------
# Isolation Strategy
#-------------------------------------------------------------------------------


#-------- CA53 iso --------- 

set_isolation iso_ca53_0 -domain PDCORTEXA53 \
    -isolation_supply_set PDCORTEXA53.default_isolation \
    -clamp_value 0 \
    -applies_to outputs \
    -isolation_signal nISOLATECORTEXA53 \
    -isolation_sense low \
    -location self	 
    
set_isolation iso_ca53_1 -domain PDCORTEXA53 \
    -isolation_supply_set PDCORTEXA53.default_isolation \
    -clamp_value 1 \
    -elements "$CA53_CLAMP1" \
    -isolation_signal nISOLATECORTEXA53 \
    -isolation_sense low \
    -location self
    
    
#-------- L2 iso ---------    

set_isolation iso_l2_out_0 -domain PDL2 \
    -isolation_supply_set PDCORTEXA53.primary \
    -clamp_value 0 \
    -applies_to outputs \
    -isolation_signal nISOLATEL2 \
    -isolation_sense low \
    -location parent
        
# -------- cpu 0 iso ---------  

set_isolation iso_cpu0_0 -domain PDCPU0 \
    -isolation_supply_set PDCORTEXA53.primary \
    -clamp_value 0 \
    -applies_to outputs \
    -isolation_signal nISOLATECPU0 \
    -isolation_sense low \
    -location parent
    
set_isolation iso_cpu0_1 -domain PDCPU0 \
    -isolation_supply_set PDCORTEXA53.primary \
    -clamp_value 1 \
    -elements "$CPU0_CLAMP1" \
    -isolation_signal nISOLATECPU0 \
    -isolation_sense low \
    -location parent 

# -------- cpu 0 iso advsimd ---------  

set_isolation iso_cpu0advsimd_0 -domain PDCPUADVSIMD0 \
    -isolation_supply_set PDCPU0.primary \
    -clamp_value 0 \
    -applies_to outputs \
    -isolation_signal nISOLATECPU0ADVSIMD \
    -isolation_sense low \
    -location parent

#-------------------------------------------------------------------------------
# Retention Strategy
#-------------------------------------------------------------------------------

create_logic_port -direction in nRETNL2
create_logic_port -direction in nRETNCPU0
create_logic_port -direction in nRETNCPU0ADVSIMD

create_logic_net nRETNL2
create_logic_net nRETNCPU0
create_logic_net nRETNCPU0ADVSIMD

connect_logic_net nRETNL2	   -ports nRETNL2
connect_logic_net nRETNCPU0	   -ports nRETNCPU0
connect_logic_net nRETNCPU0ADVSIMD -ports nRETNCPU0ADVSIMD

# -------- L2 ret ---------    

set_retention ret_l2 -domain PDL2 -retention_supply_set PDL2.default_retention -elements "$L2_hier"  \
    -save_signal "nRETNL2 low" -restore_signal "nRETNL2 high"

# -------- cpu 0 ret --------- 

set_retention ret_cpu0 -domain PDCPU0 -retention_supply_set PDCPU0.default_retention -elements "$CPU0_hier" \
    -save_signal "nRETNCPU0 low" -restore_signal "nRETNCPU0 high"

# -------- cpu 0 ret advsimd --------- 

set_retention ret_cpuadvsimd0 -domain PDCPUADVSIMD0 -retention_supply_set PDCPUADVSIMD0.default_retention -elements "$FPU0_hier" \
    -save_signal "nRETNCPU0ADVSIMD low" -restore_signal "nRETNCPU0ADVSIMD high"
    


#-------------------------------------------------------------------------------
# Connect RAM power pins to related supplies

#-------------------------------------------------------------------------------

set cpu_rams "\
                   u_idata_bank0_h1 \
                   u_idata_bank0_h0 \
                   u_idata_bank0_l1 \
                   u_idata_bank0_l0 \
                   u_idata_bank1_h1 \
                   u_idata_bank1_h0 \
                   u_idata_bank1_l1 \
                   u_idata_bank1_l0 \
                   u_itag_ram0 \
                   u_itag_ram1 \
                   u_ddata_bank0 \
                   u_ddata_bank1 \
                   u_ddata_bank2 \
                   u_ddata_bank3 \
                   u_ddata_bank4 \
                   u_ddata_bank5 \
                   u_ddata_bank6 \
                   u_ddata_bank7 \
                   u_dtag_bank0 \
                   u_dtag_bank1 \
                   u_dtag_bank2 \
                   u_dtag_bank3 \
                   u_ddirty_ram \
                   u_tlb_bank0 \
                   u_tlb_bank1 \
                   u_tlb_bank2 \
                   u_tlb_bank3 \
                   u_btac_stg0 \
                   u_btac_stg1 \	
                "
             
#CPU0

foreach ram $cpu_rams {
   set power_pin_vddce ${cpu0_name}/u_ca53_caches_tlb_rams/${ram}/VDDCE
   set power_pin_vddpe ${cpu0_name}/u_ca53_caches_tlb_rams/${ram}/VDDPE
   set power_pin_vsse ${cpu0_name}/u_ca53_caches_tlb_rams/${ram}/VSSE
   connect_supply_net VDD -ports $power_pin_vddce
   connect_supply_net VDD -ports $power_pin_vddpe
   connect_supply_net VSS -ports $power_pin_vsse
}

#L2

set l1d_tagrams [find_objects . -object_type inst -pattern u_ca53_l2/u_ca53scu_l1d_tagrams/g_l1d_cpu*_rams*u_l1d_tagram_cpu*_way*]
set l2_tagrams [find_objects u_ca53_l2 -object_type inst -pattern *u_l2_tagram_way* -transitive true]
set l2_datarams [concat [find_objects u_ca53_l2 -object_type inst -pattern *u_l2_dataram_*high -transitive true] [find_objects u_ca53_l2 -object_type inst -pattern *u_l2_dataram_*low -transitive true]]
set victimram [find_objects u_ca53_l2 -object_type inst -pattern *u_l2_victimram* -transitive true]
foreach ram [concat $l1d_tagrams $l2_tagrams $l2_datarams $victimram] {
   set power_pin_vddce $ram/VDDCE
   set power_pin_vddpe $ram/VDDPE
   set power_pin_vsse $ram/VSSE
   connect_supply_net VDD -ports $power_pin_vddce
   connect_supply_net VDD -ports $power_pin_vddpe
   connect_supply_net VSS -ports $power_pin_vsse
}

#-------------------------------------------------------------------------------
# Power States
#-------------------------------------------------------------------------------

  
#------CPU0-------
add_power_state PDCPU0.primary  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nPWRUPCPU0 == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}     || ground == {OFF 0.0}}     -logic_expr {nPWRUPCPU0 == 1}}
  
add_power_state PDCPU0.default_retention  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nRETNCPU0 == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}     || ground == {OFF 0.0}}     -logic_expr {nRETNCPU0 == 1}}
    
add_power_state PDCPUADVSIMD0.primary  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nPWRUPCPU0ADVSIMD == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}     || ground == {OFF 0.0}}     -logic_expr {nPWRUPCPU0ADVSIMD == 1}} 
  
add_power_state PDCPUADVSIMD0.default_retention  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nRETNCPU0ADVSIMD == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}    || ground == {OFF 0.0}}	   -logic_expr {nRETNCPU0ADVSIMD == 1}}	   
    
#------L2 & CA53-------   
add_power_state PDL2.primary  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nPWRUPL2 == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}    || ground == {OFF 0.0}}	   -logic_expr {nPWRUPL2 == 1}} 
  
add_power_state PDL2.default_retention  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nRETNL2 == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}    || ground == {OFF 0.0}}	   -logic_expr {nRETNL2 == 1}}	   

add_power_state PDCORTEXA53.primary  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}} -logic_expr {nPWRUPCORTEXA53 == 0}} \
  -state OFF {-supply_expr {power == {OFF 0.0}     || ground == {OFF 0.0}}     -logic_expr {nPWRUPCORTEXA53 == 1}} 
  
add_power_state PDCORTEXA53.default_isolation  \
  -state ON  {-supply_expr {power == {FULL_ON 0.8} && ground == {FULL_ON 0.0}}} \
  -state OFF {-supply_expr {power == {OFF 0.0}     || ground == {OFF 0.0}}} 
  
