# connect_logic_net CPU_ADVSIMD_isolaten  -ports u_megasoc_chip/u_megasoc_system/u_megasoc_tech_wrapper/u_megasoc_power_control/u_megasoc_CPU_power_control/u_pck_ppu_cpu_neon_q/devisolaten_o
# 
