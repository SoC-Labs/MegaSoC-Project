# connect_logic_net CPU_L2_isolaten       -ports $CA53_path/nISOLATECORTEXA53
# connect_logic_net CPU_L2_isolaten       -ports $CA53_path/nISOLATEL2
# connect_logic_net CPU_ADVSIMD_isolaten  -ports $CA53_path/nISOLATECPU0ADVSIMD
# 
