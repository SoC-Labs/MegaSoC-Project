     .PSLVERR(PSLVERR_TIMER0), // Device error response
-    .EXTIN(RT_CLK),   // Extenal input: real time clock 32.768 kHz
+    .EXTIN(rt_extin), // Extenal input: real time clock 32.768 kHz (see rt_extin above)
     .TIMERINT(timer0_int)
 );
 
