+// 2026-09-30: data-domain view of the RT clock for Timer0's EXTIN.
+//
+// cmsdk_apb_timer does not use EXTIN as a clock: it SAMPLES it on PCLK
+// (ext_in_sync1 <= EXTIN) and edge-detects. On the ASIC RT_CLK is a real
+// 32.768 kHz square wave, so sampling it works. On FPGA RT_CLK is now a gated
+// copy of PCLK (haps_top.sv) - high for half a PCLK period once every 610
+// cycles, rising just after a PCLK edge and falling before the next - so a
+// PCLK-edge sampler would land on its transition every time and never
+// reliably see it high.
+//
+// rt_clk_div[0] toggles on every RT_CLK pulse and is an ordinary flop output,
+// so PCLK logic can sample it as a same-clock path. XOR with a one-cycle-
+// delayed copy gives one PCLK-wide pulse per RT tick: the timer's edge
+// detector sees exactly one rising edge per tick, i.e. the same 32.787 kHz
+// count rate an external-clock-mode timer would see from the real pin.
+// (Enable-mode behaviour differs - a one-cycle pulse rather than a 50% duty
+// level - which is inherent in not having a real square wave.)
+`ifdef FPGA_BUILD
+reg  rt_tog_q;
+always @(posedge PCLK or negedge PRESETn) begin
+    if(~PRESETn)
+        rt_tog_q <= 1'b0;
+    else
+        rt_tog_q <= rt_clk_div[0];
+end
+wire rt_extin = rt_clk_div[0] ^ rt_tog_q;
+`else
+wire rt_extin = RT_CLK;
+`endif
+
 cmsdk_apb_timer u_apb_timer0(
     .PCLK(PCLK),    // PCLK for timer operation
     .PCLKG(PCLK),   // Gated clock
@@ -656,7 +699,7 @@
