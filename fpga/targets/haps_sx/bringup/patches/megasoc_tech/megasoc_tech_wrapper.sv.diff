+    scu_ar_block_sync2    <= scu_ar_block_sync1;
+end
+wire gov_inv_all_req_dbg = gov_inv_all_req_sync2;
+wire scu_ar_block_dbg    = scu_ar_block_sync2;
+
+// 2026-08-28: dpu_expt_idle_dbg's raw hardware data showed severe UART
+// logger corruption/garbling - the exact known signature (from earlier
+// this session, IDs 03/06/09 and 02/05) of a signal toggling far too fast
+// for the edge-detect FIFO to keep up. That means the DPU's exception FSM
+// isn't settling into IDLE and staying there - it's repeatedly cycling
+// back into the exception sequence. Since fpu_interlock_iss_dbg never
+// asserts (ruling out that specific stall), and this same FSM handles ALL
+// exceptions/interrupts, not just the initial reset sequence, a
+// continuously-pending or stuck interrupt into the core (from the GIC-400,
+// checked earlier this session for wrong tie-offs but not deeply traced)
+// could be repeatedly re-triggering it before the core ever gets a chance
+// to issue a real fetch. nIRQCPU/nFIQCPU are active-LOW, plain internal
