+// -------------------------------------------------------------------------
+// Debug taps: CPU's own AXI read-address channel, right at the CPU/
+// interconnect boundary (megasoc_cpu_ss <-> NIC-400 A53 initiator port),
+// before any interconnect routing/decode. Every capture so far has
+// watched the ROM_wrapper slave-side signals; this tells us whether the
+// core ever issues a read request at all, versus issuing one that gets
+// lost/misrouted somewhere in the interconnect on the way to ROM.
+// -------------------------------------------------------------------------
+wire cpu_axi_arvalid_dbg = CPU_AXI.ARVALID;
+wire cpu_axi_arready_dbg = CPU_AXI.ARREADY;
+
+// 2026-08-12: sticky "ever asserted" latch, independent of debug_uart_probe's
+// own FIFO/priority mechanics entirely - a simulation investigation raised a
+// real concern that a fast-toggling ARVALID could in principle be starved
+// out of the edge-detect log even while genuinely asserting in hardware.
+// This bypasses that question completely: once ARVALID goes high even once
+// after SYS_RESETn releases, this latches to 1 and stays there for the rest
+// of that boot attempt, resetting only on the next SYS_RESETn (auto-reset)
+// cycle - a ground-truth answer independent of logger timing/starvation.
+logic cpu_axi_arvalid_ever_dbg;
+always_ff @(posedge SYS_CLK or negedge SYS_RESETn)
+    if (!SYS_RESETn)          cpu_axi_arvalid_ever_dbg <= 1'b0;
+    else if (CPU_AXI.ARVALID) cpu_axi_arvalid_ever_dbg <= 1'b1;
+
+// 2026-10-01: boot-progress milestones as sticky "ever happened" flags, each
+// resetting with SYS_RESETn (i.e. per auto-reset boot attempt). Build 37 on
+// hardware showed ARVALID asserting in 9/9 boots and the L2 issuing read
+// requests continuously for the whole 10 s window, but nothing on the console
+// and the logger starved by that per-transaction traffic (scu_ext_ar_valid at
+// ID 05 produced 64,865 of 64,910 lines). These flags answer "how far does
+// boot get" without depending on the logger keeping up:
+//   rom_rvalid_ever_dbg    - ROM ever returned read data
+//   sram_write_ever_dbg    - any write to SRAM (the boot ROM's first store)
+//   sram_boot_write_dbg    - the boot ROM's known first write, 0x0080_1ff0
+//                            (low 16 bits only, so it holds whether or not
+//                            the NIC strips the base address)
+//   uart0_apb_write_ever_dbg - any APB write to UART0 (= reached UART init)
+//   flash_ahb_access_ever_dbg - any AHB transfer to the QSPI flash window
+//   cpu_axi_rvalid_ever_dbg  - the CPU ever received read data at its port
+logic rom_rvalid_ever_dbg, sram_write_ever_dbg, sram_boot_write_dbg;
+logic uart0_apb_write_ever_dbg, flash_ahb_access_ever_dbg, cpu_axi_rvalid_ever_dbg;
+always_ff @(posedge SYS_CLK or negedge SYS_RESETn)
