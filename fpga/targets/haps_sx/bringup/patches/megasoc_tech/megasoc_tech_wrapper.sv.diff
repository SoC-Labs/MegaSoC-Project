+// -------------------------------------------------------------------------
+// Debug taps: 2026-08-27 follow-up. core0_clk_ever_toggled_dbg (above)
+// proved CPU core 0's own gated execution clock never toggles. A research
+// pass through the governor's clock-gate-enable RTL (ca53governor_cpu.v,
+// ca53governor_cpu_clk_reset.v, ca53governor_cpu_power.v) found every
+// input in that chain (nCPUPORESET/nL2RESET/nMBISTRESET/DFTRSTDISABLE,
+// the gate_clk_req wfx_fsm) traces to a real, plausibly-correct signal -
+// by the RTL's own logic the clock should already be running once
+// STANDBYWFI drops, which we've independently confirmed it does. These
+// two taps check that directly on real hardware rather than by static
+// reading:
+//   - gate_clk_req_dbg: the governor's own power-FSM (wfx_fsm) request to
+//     gate the clock, declared as plain wire `gate_clk_req` in
+//     ca53governor_cpu.v (connects u_governor_cpu_power's output to
+//     u_governor_cpu_clk_reset's input). Static RTL reading says this
+//     should be 0 (not requesting gate) once the FSM reaches AWAKE.
+//   - clk_enable_dbg: `clk_enable` in ca53governor_cpu_clk_reset.v -
+//     directly drives u_ca53_cell_clkgate's clk_enable_i port, i.e. the
+//     literal signal reaching the clock-gate cell's enable pin. If this
+//     is 1 while core0_clk_ever_toggled_dbg (ID 0x03) stays 0, the
+//     enable reaches the gate but the gate itself (promoted to BUFGCE via
+//     defparam to fix the earlier clock-tree timing methodology warning)
+//     isn't passing it through - an implementation-level BUFGCE failure,
+//     not a governor logic bug. If clk_enable_dbg is 0, the real hardware
+//     disagrees with the static RTL analysis somewhere upstream and
+//     gate_clk_req_dbg narrows down which side of that chain to recheck.
+// -------------------------------------------------------------------------
+wire gate_clk_req_dbg = u_megasoc_cpu_ss.u_cortexa53.u_ca53_l2.u_ca53_l2noram.u_ca53governor.g_governor_cpu[0].u_governor_cpu.gate_clk_req;
+wire clk_enable_dbg = u_megasoc_cpu_ss.u_cortexa53.u_ca53_l2.u_ca53_l2noram.u_ca53governor.g_governor_cpu[0].u_governor_cpu.u_governor_cpu_clk_reset.clk_enable;
+
+// 2026-08-27: follow-up to the clock-gate recovery/removal fix. The gate
+// now reliably runs (core0_clk_ever_toggled_dbg confirmed 10/10 on real
+// hardware), but ARVALID/its sticky latch still never asserted in that
+// same capture. clk_enable_dbg only gates whether CLKIN reaches the core -
+// it says nothing about whether the CORE ITSELF is out of reset. That's a
+// separate signal: megasoc_cpu_ss.sv wires the CORTEXA53's nCORERESET pin
+// directly to (CPU_CORE_WRMRSTn & CPU_L2_RESETn) (the 2026-08-17 core/L2
+// ordering experiment) - each input individually confirmed releasing every
+// cycle, but the AND'd result actually reaching the macro's reset pin has
+// never been directly observed. Since the two inputs release a few cycles
+// apart, if this recombination has its own timing quirk the core could now
+// be fully clocked but still permanently held in reset - same symptom.
+wire ncorereset_dbg = CPU_CORE_WRMRSTn & CPU_L2_RESETn;
