+    .HWRITE(FLASH_AHB.HWRITE), .HSIZE(FLASH_AHB.HSIZE),
+    .HBURST(FLASH_AHB.HBURST), .HPROT(FLASH_AHB.HPROT),
+    .HWDATA(FLASH_AHB.HWDATA), .HSELx(FLASH_AHB.HSEL),
+    .HRDATA(FLASH_AHB.HRDATA), .HREADY(FLASH_AHB.HREADY),
+    .HREADYOUT(FLASH_AHB.HREADYOUT), .HRESP(FLASH_AHB.HRESP),
