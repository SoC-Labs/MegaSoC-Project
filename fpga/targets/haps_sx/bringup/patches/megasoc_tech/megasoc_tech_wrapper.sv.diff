+// 2026-09-04: the two raw taps above are registers/combinational logic
+// living in the CPU's own gated clock domain (clk_cpu), sampled directly
+// by debug_uart_probe which runs on SYS_CLK - an unsynchronized clock-
+// domain crossing, unlike every other raw-signal tap added so far this
+// session (those were either already stable/registered appropriately or
+// handled via a sticky latch). First hardware capture of these two came
+// back with the exact known signature of a fast-toggling/metastable
+// source completely starving the debug logger's priority-encoded FIFO
+// (only ID 0x00 - an even lower ID - got through at all; nothing else,
+// not even the new signals themselves, appeared even once across 38
+// boot cycles). Adding a standard 2-flop synchronizer, matching the
+// pattern ARM's own ca53_cell_sync uses, before these reach the probe
+// bus - resolves any metastability at the sampling flop and gives a
+// clean, stable value for the logger to observe.
+(* ASYNC_REG = "true" *) logic gov_inv_all_req_sync1, gov_inv_all_req_sync2;
+(* ASYNC_REG = "true" *) logic scu_ar_block_sync1, scu_ar_block_sync2;
