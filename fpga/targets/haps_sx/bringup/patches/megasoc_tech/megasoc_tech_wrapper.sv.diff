+end else begin : g_no_flash_emu
+assign emu_io_o = 4'h0; assign emu_io_e = 4'h0; assign emu_qpi = 1'b0; assign emu_busy = 1'b0; assign bd_rdata = 64'h0;
+end endgenerate
+top_ahb_qspi #(.DATA_W(32)) u_sl_ahb_qspi(
