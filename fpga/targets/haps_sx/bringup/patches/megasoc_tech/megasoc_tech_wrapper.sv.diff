+//   value[15:0]  sampled every 50 ms from a register holding the LAST CPU AXI
+//                address accepted (AR or AW), encoded {region[2:0], addr[14:2]}
+//                (see dbg_enc43) - i.e. the final access before the bus went quiet.
+logic [15:0] dbg_val, dbg_last_addr;
+logic [19:0] dbg_tick_cnt;
+logic        dbg_rd_outstanding, dbg_wr_outstanding, dbg_qspi_apb_ever;
+// 2026-10-13 (build 44): the raw outstanding levels toggle on every CPU transaction
+// and saturated the whole-bus logger in build 43 (49k lines, every one flagged '!').
+// Export "stuck" versions instead: outstanding continuously for >= 2^15 cycles (1.6 ms).
+logic [15:0] dbg_rd_stuck_cnt, dbg_wr_stuck_cnt;
+wire         dbg_rd_stuck = dbg_rd_stuck_cnt[15];
+wire         dbg_wr_stuck = dbg_wr_stuck_cnt[15];
+logic        dbg_vector_fetch_ever;
+wire         cpu_ar_hs = CPU_AXI.ARVALID & CPU_AXI.ARREADY;
+wire         cpu_aw_hs = CPU_AXI.AWVALID & CPU_AXI.AWREADY;
+wire         cpu_r_last = CPU_AXI.RVALID & CPU_AXI.RREADY & CPU_AXI.RLAST;
+wire         cpu_b_hs  = CPU_AXI.BVALID & CPU_AXI.BREADY;
+wire         cpu_ar_vec = CPU_AXI.ARPROT[2] & (CPU_AXI.ARADDR[43:12] == 32'h0) & CPU_AXI.ARADDR[11];
+function automatic [15:0] dbg_enc43(input [43:0] a);
+    // 3-bit region code + 13-bit word offset (32 KB window):
+    //   0 ROM 0x0000-0x7FFF   1 ROM 0x8000-0xFFFF   2 SRAM (0x0080_0000)
+    //   3 QSPI flash window (0x0040_0000)   4 QSPI regs (0x0100_0000)
+    //   5 peripherals (0x4000_0000)   7 anything above 0x8000_0000
+    logic [2:0] r;
+    if (a[31])      r = 3'd7;
+    else if (a[30]) r = 3'd5;
+    else if (a[24]) r = 3'd4;
+    else if (a[23]) r = 3'd2;
+    else if (a[22]) r = 3'd3;
+    else            r = {2'b00, a[15]};
