+    if (!SYS_RESETn) begin
+        dbg_val <= 16'h0; dbg_last_addr <= 16'h0; dbg_tick_cnt <= 20'd0;
+        dbg_rd_outstanding <= 1'b0; dbg_wr_outstanding <= 1'b0;
+        dbg_qspi_apb_ever <= 1'b0; dbg_vector_fetch_ever <= 1'b0;
