+    .PSEL(FLASH_CTRL_APB.psel), .PENABLE(FLASH_CTRL_APB.penable),
+    .PWRITE(FLASH_CTRL_APB.pwrite), .PWDATA(FLASH_CTRL_APB.pwdata),
+    .PSTRB(FLASH_CTRL_APB.pstrb), .PRDATA(FLASH_CTRL_APB.prdata),
+    .PREADY(FLASH_CTRL_APB.pready), .PSLVERR(FLASH_CTRL_APB.pslverr),
+    .QSPI_SCLK(QSPI_SCLK), .QSPI_nCS(QSPI_nCS),
+    .QSPI_IO_o(QSPI_IO_o), .QSPI_IO_i(qspi_io_i_int), .QSPI_IO_e(QSPI_IO_e),
+    .IRQ_QSPI_FINISHED(QSPI_IRQ)
