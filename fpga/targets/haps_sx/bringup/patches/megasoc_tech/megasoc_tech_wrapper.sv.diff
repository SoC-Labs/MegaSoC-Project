+        if (!dbg_rd_outstanding)        dbg_rd_stuck_cnt <= 16'd0;
+        else if (!dbg_rd_stuck_cnt[15]) dbg_rd_stuck_cnt <= dbg_rd_stuck_cnt + 1'b1;
+        if (!dbg_wr_outstanding)        dbg_wr_stuck_cnt <= 16'd0;
+        else if (!dbg_wr_stuck_cnt[15]) dbg_wr_stuck_cnt <= dbg_wr_stuck_cnt + 1'b1;
+    end
