+wire dpu_expt_idle_dbg = u_megasoc_cpu_ss.u_cortexa53.g_ca53_cpu[0].u_ca53_cpu.u_ca53_noram.u_ca53dpu.u_dpu_ctl.u_dpu_exception.expt_idle_o;
