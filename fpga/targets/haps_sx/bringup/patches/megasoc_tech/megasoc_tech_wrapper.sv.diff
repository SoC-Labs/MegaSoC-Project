+// =========================================================================
+// Power Control Interfaces
+// =========================================================================
+qchannel ROM_qchan_q(), ROM_qchan_p();
+wire ROM_RESETn;
+wire AWAKEUP_ROM;
+
+qchannel SRAM_qchan_q(), SRAM_qchan_p();
+wire AWAKEUP_SRAM;
+wire SRAM_RESETn;
+
+qchannel CPU_CORE_q(), CPU_NEON_q(), CPU_L2_q();
+wire CPU_CORE_PORESETn, CPU_CORE_WRMRSTn;
+wire CPU_L2_RESETn;
+
+// -------------------------------------------------------------------------
+// Debug taps: CPU_L2 power domain. Structurally this is wired identically
+// to the working CPU_CORE PPU pattern (megasoc_CPU_power_control.sv), but
+// it has never actually been observed on hardware - L2 sits directly in
+// the instruction fetch path, so if this Q-channel handshake (the other
+// half of which comes from inside the CA53 macro itself, not from this
+// wrapper) hasn't actually completed, the core could be blocked from
+// fetching regardless of how healthy CPU_CORE's own reset looks.
+// -------------------------------------------------------------------------
+wire CPU_L2_qreqn_dbg    = CPU_L2_q.qreqn;
+wire CPU_L2_qacceptn_dbg = CPU_L2_q.qacceptn;
+wire CPU_L2_qactive_dbg  = CPU_L2_q.qactive;
+
+// -------------------------------------------------------------------------
+// Debug taps: CPU_NEON power domain - the last of the three CA53 power
+// domains not yet observed on hardware. Unlike CORE/L2, NEON has no
+// separate architectural reset output wired anywhere (megasoc_CPU_power_
+// control.sv leaves its devporesetn_o/devwarmresetn_o unconnected) - only
+// its Q-channel is connected to the CORTEXA53 macro's NEONQ* ports, so
+// only the Q-channel is tappable here.
+// -------------------------------------------------------------------------
+wire CPU_NEON_qreqn_dbg    = CPU_NEON_q.qreqn;
+wire CPU_NEON_qacceptn_dbg = CPU_NEON_q.qacceptn;
+wire CPU_NEON_qactive_dbg  = CPU_NEON_q.qactive;
+
+// -------------------------------------------------------------------------
+// Debug taps: CORTEXA53's own standby/WFI status outputs - previously left
+// entirely unconnected in megasoc_cpu_ss.sv (tied to `()`). ARVALID has
+// been confirmed, via unbounded-time UART logging, to never assert at the
+// CPU's own AXI master port at all - meaning the block is somewhere
+// upstream of the interconnect entirely. These taps check whether the
+// core is parked in a WFI/WFE/L2-standby state instead of ever actively
+// fetching - something no signal probed so far this investigation could
+// distinguish. XMR straight into u_cortexa53's own port names, same
+// pattern already used for the governor/SCU clock-gate taps.
+// -------------------------------------------------------------------------
+wire cpu_standbywfi_dbg   = u_megasoc_cpu_ss.u_cortexa53.STANDBYWFI;
+wire cpu_standbywfe_dbg   = u_megasoc_cpu_ss.u_cortexa53.STANDBYWFE;
+wire cpu_standbywfil2_dbg = u_megasoc_cpu_ss.u_cortexa53.STANDBYWFIL2;
+
+// -------------------------------------------------------------------------
+// Debug taps: ROM Q-channel handshake (bring-up visibility only).
+// Plain wires instead of tapping the interface directly - keeps this
+// robust to how Vivado's debug-insertion flow resolves SV interface
+// modport signals post-synthesis.
+// -------------------------------------------------------------------------
+wire ROM_qchan_q_qreqn_dbg    = ROM_qchan_q.qreqn;
+wire ROM_qchan_q_qacceptn_dbg = ROM_qchan_q.qacceptn;
+wire ROM_qchan_q_qactive_dbg  = ROM_qchan_q.qactive;
+wire ROM_qchan_p_qreqn_dbg    = ROM_qchan_p.qreqn;
+wire ROM_qchan_p_qacceptn_dbg = ROM_qchan_p.qacceptn;
+wire ROM_qchan_p_qactive_dbg  = ROM_qchan_p.qactive;
+
+// -------------------------------------------------------------------------
+// Debug taps: ROM's AXI slave-side read-data channel. The 2026-08-03 UART
+// capture showed ROM_qchan_p/q_qactive pulsing in the same narrow window
+// as ARVALID and both NIC-400 taps - the first correlated evidence all
+// session that a request actually reached the ROM. These two check
+// whether it went further than the Q-channel handshake: did the ROM
+// actually return valid read data (RVALID), and was the requester ready
+// for it (RREADY, expected constant 1 per every prior ILA capture).
+// -------------------------------------------------------------------------
+wire rom_rvalid_dbg = u_ROM_wrapper.RVALID;
+wire rom_rready_dbg = u_ROM_wrapper.RREADY;
+
+// NOTE: the CA53-internal-gated-clock tick-counter debug tap that used to
+// live here (clocked via XMR off u_governor_cpu_clk_reset's clk_gated_o)
+// has been removed. It confirmed its own purpose indirectly - checking
+// timing after adding it showed 20k+ failing setup paths dominated by
+// PREICG_X4B_A9TS_C31-based clock gates elsewhere in the core (SCU, GIC),
+// a pre-existing issue independent of this tap. Keeping a register clocked
+// from an undeclared, LUT-driven internal clock net was itself an
+// unconstrained CDC and not worth carrying forward once the real fix
+// (PREICG_X4B_A9TS_C31.sv -> BUFGCE) is in place.
+
+// -------------------------------------------------------------------------
+// Selective clock-gate primitive override (PREICG_X4B_A9TS_C31.sv Revision
+// 0.03). Blanket-converting every PREICG_X4B_A9TS_C31 instance to BUFGCE
+// exhausted clock routing tracks (Place 30-678) once ~100-140 independent
+// global clock domains all needed to reach overlapping, congested regions
+// of the CA53/SCU. Instead, only promote the two instances confirmed to be
+// genuinely high-fanout and structurally critical - identified from the
+// 20k+ failing-path sample and the original clock-tree fanout warnings -
+// to BUFGCE via defparam. Everything else keeps the default (behavioral
+// latch+AND, synthesizes as local LUT logic - fine for small, low-fanout
+// gates, which is the vast majority of instances):
+//   - CPU core 0's own execution clock gate (governor). If this one is
+//     stuck disabled, the core never executes a single instruction
+//     regardless of reset state - the leading hypothesis for why the
+//     ROM AXI port has never seen a single ARVALID.
+//   - The L2 SCU (Snoop Control Unit) main clock gate - the single
+//     highest-fanout offender observed in the failing-path sample.
+// NOTE: GIC's clock gates were originally included here too but removed -
+// GIC400.v's clock gating goes through gic400_inter_clkgate.v, a
+// completely separate self-contained model with its own inline latch+AND
+// logic (not an instance of PREICG_X4B_A9TS_C31 at all), so USE_BUFGCE
+// does not apply there. Attempting it produced a hard synthesis error
+// (Synth 8-476, "no matching instance"), not a graceful skip - defparam
+// targeting a genuinely nonexistent instance is NOT safe to leave in
+// speculatively. If GIC clock-gate timing needs the same treatment later,
+// it requires editing gic400_inter_clkgate.v directly, as a separate task.
+// -------------------------------------------------------------------------
+// 2026-09-21: REMOVED - these two defparams were dead code and had been for a
+// while, which made the commentary above (and in haps_top.xdc) describe a
+// build that no longer existed.
+//
+// PREICG_X4B_A9TS_C31.sv Rev 0.04 added FPGA_BYPASS_GATING, defaulting to 1,
+// and its generate tests that parameter FIRST:
+//     if (FPGA_BYPASS_GATING)      -> assign ECK = CK;   // always taken
+//     else if (USE_BUFGCE)         -> BUFGCE ...         // unreachable
+// so overriding USE_BUFGCE could never have any effect. (Separately, IEEE
+// 1800 does not permit defparam to modify a parameter that controls a
+// generate condition, so even without the bypass this was not a sound
+// mechanism.) Confirmed against the routed netlist of 2026-09-21: zero
+// BUFGCE cells originate from these instances.
+//
+// If per-instance BUFGCE promotion is ever wanted again, do it by
+// instantiating a separately-named wrapper module at a site we own, not by
+// defparam into licensed RTL.
+//
+// defparam u_megasoc_cpu_ss.u_cortexa53.u_ca53_l2.u_ca53_l2noram.u_ca53governor.g_governor_cpu[0].u_governor_cpu.u_governor_cpu_clk_reset.u_ca53_cell_clkgate.u_clkgate.USE_BUFGCE = 1;
+// defparam u_megasoc_cpu_ss.u_cortexa53.u_ca53_l2.u_ca53_l2noram.u_ca53scu.u_clk.u_clkgate.u_clkgate.USE_BUFGCE = 1;
+
+// -------------------------------------------------------------------------
+// Properly-synchronized check: is CA53 core 0's own execution clock gate
+// (the same instance just promoted to BUFGCE above) actually toggling?
+// An earlier attempt at this read a multi-bit counter directly across an
+// unconstrained clock-domain crossing - it wasn't a dominant contributor
+// to the timing failures found afterward, but was a genuine metastability
+// risk and got flagged by methodology DRC, so it was removed rather than
+// left in. This version does it correctly: a single-bit toggle flop in
+// the source (gated-clock) domain - a single bit is the only width safe
+// to cross without extra handshaking - synchronized into SYS_CLK via a
+// standard 2-flop synchronizer. ASYNC_REG prevents synthesis from
+// retiming or optimizing away the synchronizer stages. The inherently
+// asynchronous first-stage crossing is explicitly false-pathed in the
+// XDC rather than left for the timer to guess at.
+// If ca53_core0_clk_toggle_sync2 changes value across an ILA capture, the
+// gated clock is genuinely toggling; if frozen for the whole capture, it
+// isn't - regardless of what the reset/Q-channel signals say.
+// -------------------------------------------------------------------------
+logic ca53_core0_clk_toggle_src = 1'b0;
+always @(posedge u_megasoc_cpu_ss.u_cortexa53.u_ca53_l2.u_ca53_l2noram.u_ca53governor.g_governor_cpu[0].u_governor_cpu.u_governor_cpu_clk_reset.u_ca53_cell_clkgate.clk_gated_o)
+  ca53_core0_clk_toggle_src <= ~ca53_core0_clk_toggle_src;
+
+// 2026-09-21: these two now reset from SYS_RESETn, like the sticky latch
+// below. Previously they had initialisers only, which apply once at
+// configuration - but SYS_RESETn re-asserts every ~10 s from haps_top.sv's
+// auto-reset, so on every boot attempt after the first, _sync2 kept its old
+// value while _sync2_prev was cleared to 0. If _sync2 happened to be 1, the
+// first clock after release saw sync2(1) != prev(0) and set
+// core0_clk_ever_toggled_dbg - with a completely dead clock. Roughly half of
+// all boot attempts reported a false "clock toggled"; only the first boot
+// after configuration was trustworthy.
+(* ASYNC_REG = "true" *) logic ca53_core0_clk_toggle_sync1 = 1'b0;
+(* ASYNC_REG = "true" *) logic ca53_core0_clk_toggle_sync2 = 1'b0;
+always @(posedge SYS_CLK or negedge SYS_RESETn) begin
+  if (!SYS_RESETn) begin
+    ca53_core0_clk_toggle_sync1 <= 1'b0;
+    ca53_core0_clk_toggle_sync2 <= 1'b0;
+  end else begin
+    ca53_core0_clk_toggle_sync1 <= ca53_core0_clk_toggle_src;
+    ca53_core0_clk_toggle_sync2 <= ca53_core0_clk_toggle_sync1;
+  end
+end
+
+// 2026-08-26: sticky "ever toggled" latch on the synchronized gated-clock
+// toggle flop above, same rationale as cpu_axi_arvalid_ever_dbg - the raw
+// signal toggles too fast to observe directly through debug_uart_probe
+// without starving every other signal (same failure mode already hit and
+// fixed for IDs 03/06/09 on 2026-08-05/12), but we only actually need a
+// single bit of information from it: did CA53 core 0's own gated execution
+// clock ever tick at all during this boot attempt? If it never toggles,
+// the core is frozen at the clock source and nothing downstream (IFU, SCU
