+    .HCLK(SYS_CLK), .HRESETn(SYS_RESETn),
+    .SCLK(QSPI_SCLK), .nCS(QSPI_nCS), .IO_i(QSPI_IO_o), .IO_o(emu_io_o), .IO_e(emu_io_e),
+    .bd_we(bd_we), .bd_re(bd_re), .bd_addr(bd_addr), .bd_wdata(bd_wdata), .bd_wstrb(bd_wstrb), .bd_rdata(bd_rdata),
+    .emu_qpi(emu_qpi), .emu_busy(emu_busy)
