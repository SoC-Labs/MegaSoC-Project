+// =========================================================================
+// Periodic pulse generator for ROM's ext_gt Q-channel (finding 2026-08-04):
+// tying ext_gt_qreqn to a constant 1 lets the qext_state FSM inside
+// sie300_axi5_sram_ctrl_1_lpi_ctrl.sv pass through ST_GATED exactly ONCE
+// (at reset) before permanently stranding in ST_OPEN - which permanently
+// disables resp_fsm_en (requires qext_state==ST_GATED), silently blocking
+// every read response after the first. Confirmed on hardware via the UART
+// event logger: first ROM read got a full RVALID response, second read's
+// ARVALID was accepted but never got RVALID back and stayed stuck high.
+// No real external quiescence controller drives this signal anywhere in
+// this design (megasoc_ROM_power_control.sv only implements the standard
+// clk_q/pwr_q pair) - this free-running counter mimics one: mostly
+// asserted (1 = OPEN, accepting new requests), periodically pulsed low
+// (0 = release, cycles back through START_GATE to GATED, draining any
+// queued responses) before reasserting.
+// =========================================================================
+// 2026-08-05: the first version of this counter (9-bit, toggling every
+// 512 cycles) caused ROM_qchan_q_qactive_dbg to start toggling in lockstep
+// (traced through lpi_ctrl.sv: clk_qactive = OR(pwr_qactive, pwr_q_ch_act,
+// ext_q_ch_act), and ext_q_ch_act = XOR(ext_qreqn, ext_qacceptn) - directly
+// driven by this counter) - far faster than the debug UART logger can
+// handle, producing garbled/corrupted log lines. Widened to a 20-bit
+// period (~52ms at 20MHz) to protect the logger.
+//
+// 2026-08-10: that widening was purely a logger-observability fix, not a
+// functional requirement - and it had a real functional cost we didn't
+// account for at the time. Each pass through ST_GATED only drains up to
+// 4 queued requests (arq/rq FIFO depth), so at the widened ~52ms period,
+// completing the ~9,900 ROM reads a real boot needs would take minutes,
+// not seconds - consistent with hardware capture showing exactly one
+// clean transaction (ARVALID->RVALID->clear) and then nothing, because
+// the next drain window hadn't arrived yet. The logger-flooding problem
+// this was protecting against is now independently fixed (ROM_qchan_q/p
+// _qactive_dbg, IDs 0x06/0x03, are tied off in haps_top.sv's
+// debug_probe_bus) - reverting to the original fast period restores real
+// throughput without reintroducing the log corruption.
+// 2026-09-21: DISABLED - ext_gt_qreqn is now tied to 1'b1 at the ROM_wrapper
+// instantiation below. Kept commented rather than deleted so the experiment is
+// recoverable, but do not re-enable without also connecting ext_gt_qacceptn
+// and making this a real handshake (drop qreqn, wait for qacceptn, hold, raise
+// qreqn, wait for qacceptn to return) instead of a free-running counter.
+//
+// logic [8:0] rom_ext_gate_cnt = 9'h0;
+// always_ff @(posedge SYS_CLK or negedge ROM_RESETn)
+//   if (!ROM_RESETn) rom_ext_gate_cnt <= 9'h0;
+//   else             rom_ext_gate_cnt <= rom_ext_gate_cnt + 1'b1;
+// wire rom_ext_gt_qreqn = (rom_ext_gate_cnt >= 9'd64);  // low 64 of every 512 cycles
+
+// =========================================================================
+// ROM Wrapper
+// =========================================================================
+ROM_wrapper u_ROM_wrapper(
+    .ACLK(SYS_CLK), .ARESETn(ROM_RESETn),
+    .AWVALID(ROM_AXI.AWVALID), .AWREADY(ROM_AXI.AWREADY),
+    .AWID(ROM_AXI.AWID), .AWADDR(ROM_AXI.AWADDR),
+    .AWLEN(ROM_AXI.AWLEN), .AWSIZE(ROM_AXI.AWSIZE),
+    .AWBURST(ROM_AXI.AWBURST), .AWLOCK(ROM_AXI.AWLOCK),
+    .AWPROT(ROM_AXI.AWPROT), .AWQOS(4'h0),
+    .WVALID(ROM_AXI.WVALID), .WREADY(ROM_AXI.WREADY),
+    .WDATA(ROM_AXI.WDATA), .WSTRB(ROM_AXI.WSTRB),
+    .WLAST(ROM_AXI.WLAST), .WPOISON(1'b0),
+    .BVALID(ROM_AXI.BVALID), .BREADY(ROM_AXI.BREADY),
+    .BID(ROM_AXI.BID), .BRESP(ROM_AXI.BRESP),
+    .ARVALID(ROM_AXI.ARVALID), .ARREADY(ROM_AXI.ARREADY),
+    .ARID(ROM_AXI.ARID), .ARADDR(ROM_AXI.ARADDR),
+    .ARLEN(ROM_AXI.ARLEN), .ARSIZE(ROM_AXI.ARSIZE),
+    .ARBURST(ROM_AXI.ARBURST), .ARLOCK(ROM_AXI.ARLOCK),
+    .ARPROT(ROM_AXI.ARPROT), .ARQOS(4'h0),
+    .RVALID(ROM_AXI.RVALID), .RREADY(ROM_AXI.RREADY),
+    .RID(ROM_AXI.RID), .RDATA(ROM_AXI.RDATA),
+    .RRESP(ROM_AXI.RRESP), .RLAST(ROM_AXI.RLAST),
+    .RPOISON(), .AWAKEUP(AWAKEUP_ROM),
+    // Q-channel: MUST be connected to the PPU in megasoc_ROM_power_control.
+    // ROM_RESETn is gated by a PCK-600 PPU that sequences the ROM domain ON
+    // only after this handshake completes. The previous tie-offs
+    // (.clk_qreqn(1'b1), responses unconnected) deadlocked the PPU
+    // permanently: the SRAM controller sat in ST_START_GATE and the CPU
+    // stalled on its first instruction fetch. Mirror the SRAM pattern.
+    .clk_qreqn   (ROM_qchan_q.qreqn),
+    .clk_qacceptn(ROM_qchan_q.qacceptn),
+    .clk_qdeny   (ROM_qchan_q.qdeny),
+    .clk_qactive (ROM_qchan_q.qactive),
+    .pwr_qreqn   (ROM_qchan_p.qreqn),
+    .pwr_qacceptn(ROM_qchan_p.qacceptn),
+    .pwr_qdeny   (ROM_qchan_p.qdeny),
+    .pwr_qactive (ROM_qchan_p.qactive),
+    // 2026-09-21: was rom_ext_gt_qreqn, a free-running 64-of-every-512-cycle
+    // gate request (see the disabled counter above). Two problems: the counter
+    // resets to 0, so the ROM was ext-gated and AXI-stalled for the first 64
+    // cycles after ROM_RESETn released - the exact window the CPU's first
+    // instruction fetch and the EL3 MMU table walk land in - and thereafter it
+    // stalled the ROM 12.5% of the time. It was also driven open-loop:
+    // ext_gt_qacceptn was discarded, so QREQn toggled on a fixed schedule
+    // regardless of whether the device had accepted, which is not a legal
+    // Q-channel handshake. Tied off for bring-up.
+    .ext_gt_qreqn(1'b1), .ext_gt_qacceptn(), .cfg_gate_resp(1'b0)
+);
+
+// =========================================================================
+// QSPI Flash Controller
+// =========================================================================
+// 2026-10-15 (build 49): in-FPGA flash emulator. The on-board W25Q32FW no longer accepts
+// writes or array reads (ticket N30). With USE_FLASH_EMU the QSPI controller talks to
+// qspi_flash_emu (SST26VF064B-compatible, 512 KB block RAM) instead of the pads; the pads
+// are still driven by the controller but their inputs are ignored. The emulator's store
+// is the second 512 KB window of the DRAM slave (0x8008_0000) so the UART loader fills it.
+genvar gq;
+generate for (gq = 0; gq < 4; gq = gq + 1) begin : g_qspi_emu_mux
+    assign qspi_io_i_int[gq] = USE_FLASH_EMU ? (emu_io_e[gq] ? emu_io_o[gq] : (QSPI_IO_e[gq] ? QSPI_IO_o[gq] : 1'b1)) : QSPI_IO_i[gq];
+end endgenerate
+// 2026-10-28 (build 58): only instantiated when USE_FLASH_EMU = 1. With the DDR4 bridge on the DRAM port the backdoor
+// is tied off, and Vivado then fails on the emulator's lane RAMs ('Unsupported RAM template', 7 errors, reproduced
+// standalone); in builds 50-57 the dead emulator also kept 512 KB of block RAM alive through that backdoor read path.
+generate if (USE_FLASH_EMU) begin : g_flash_emu
