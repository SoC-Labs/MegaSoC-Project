+        sram_write_ever_dbg       <= 1'b0;
+        sram_boot_write_dbg       <= 1'b0;
+        uart0_apb_write_ever_dbg  <= 1'b0;
+        flash_ahb_access_ever_dbg <= 1'b0;
+        cpu_axi_rvalid_ever_dbg   <= 1'b0;
