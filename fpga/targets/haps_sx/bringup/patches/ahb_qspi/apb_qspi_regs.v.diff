--- a/logical/apb_qspi_regs/logical/apb_qspi_regs.v
+++ b/logical/apb_qspi_regs/logical/apb_qspi_regs.v
@@ -162,8 +162,17 @@
     end
 end
 
-always @(PCLK, PADDR, QSPI_RDATA, reg0, reg1, reg2, reg3, reg8, reg9, reg10, reg11, reg12, reg13) begin
-    if(PCLK) begin
+// 2026-09-23 (Build B): was `always @(PCLK, PADDR, ...) if(PCLK) ...`, i.e. a
+// bank of 32 transparent latches gated on PCLK being high. That inferred 32
+// LDCE cells whose gate pin Vivado counts as a clock pin, contributing to the
+// 901 unanalyzed register/latch pins measured on the 2026-09-22 netlist.
+//
+// An APB read-data mux is normally pure combinational logic: the master samples
+// PRDATA at the end of the access phase, while PADDR is still valid, so holding
+// it through the PCLK low phase buys nothing. Converted to a fully-specified
+// always @(*) - the case already has a default arm, so no latch remains.
+always @(*) begin
+    begin
         case(PADDR)
             10'h000: PRDATA = reg0;
             10'h001: PRDATA = reg1;
