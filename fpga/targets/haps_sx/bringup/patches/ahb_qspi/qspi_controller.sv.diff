+
+// 2026-09-23 (Build B): was `always @(posedge QSPI_SCLK_i ...)`.
+always @(posedge HCLK or negedge HRESETn) begin
     if(~HRESETn) begin
         op_counter <= 3'h0;
         data_counter <= 3'h7;
@@ -318,7 +405,7 @@
         addr_counter <= 5'h00;
         mode_counter <= 1'b1;
